apiVersion: v1
kind: Config
preferences: {}
current-context: broken-context
clusters:
  - name: valid-cluster
    cluster:
      server: https://valid.k8s.example.com:6443
      certificate-authority-data: FAKE_CERT
users:
  - name: valid-user
    user:
      client-certificate-data: FAKE_CERT
      client-key-data: FAKE_KEY
contexts:
  # Valid context - references existing user and cluster
  - name: valid-context
    context:
      cluster: valid-cluster
      user: valid-user
      namespace: default
  # Broken context - references NON-EXISTENT user
  - name: broken-user-ctx
    context:
      cluster: valid-cluster
      user: ghost-user
      namespace: default
  # Broken context - references NON-EXISTENT cluster
  - name: broken-cluster-ctx
    context:
      cluster: ghost-cluster
      user: valid-user
      namespace: default
  # Broken context - references BOTH non-existent
  - name: totally-broken-ctx
    context:
      cluster: non-existent-cluster
      user: non-existent-user
      namespace: default
