apiVersion: v1
kind: Config
current-context: prod-cluster
clusters:
  - name: prod-cluster
    cluster:
      server: https://prod.k8s.example.com:6443
      certificate-authority-data: FAKE_CERT
  - name: aws-cluster
    cluster:
      server: https://aws.eks.example.com:6443
      certificate-authority-data: FAKE_CERT
users:
  - name: prod-admin
    user:
      client-certificate-data: FAKE_CERT
      client-key-data: FAKE_KEY
  - name: aws-admin
    user:
      client-certificate-data: FAKE_CERT
      client-key-data: FAKE_KEY
contexts:
  - name: prod-cluster
    context:
      cluster: prod-cluster
      user: prod-admin
  - name: aws-cluster
    context:
      cluster: aws-cluster
      user: aws-admin