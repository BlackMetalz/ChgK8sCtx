apiVersion: v1
kind: Config
preferences: {}
current-context: staging-cluster
clusters:
    - name: dev-cluster
      cluster:
        server: https://dev.k8s.example.com:6443
        certificate-authority-data: 
    - name: staging-cluster
      cluster:
        server: https://staging.k8s.example.com:6443
        certificate-authority-data: 
    - name: prod-cluster
      cluster:
        server: https://prod.k8s.example.com:6443
        certificate-authority-data: 
    - name: aws-eks-cluster
      cluster:
        server: https://ABCDEF1234567890.gr7.us-west-2.eks.amazonaws.com
        certificate-authority-data: 
    - name: gke-cluster
      cluster:
        server: https://35.123.45.67
        certificate-authority-data: 
users:
    - name: dev-admin
      user:
        client-certificate-data: 
        client-key-data: 
    - name: staging-admin
      user:
        client-certificate-data: 
        client-key-data: 
    - name: prod-admin
      user:
        client-certificate-data: 
        client-key-data: 
    - name: aws-eks-user
      user:
        client-certificate-data: ""
        client-key-data: ""
    - name: gke-user
      user:
        client-certificate-data: ""
        client-key-data: ""
contexts:
    - name: dev-cluster
      context:
        cluster: dev-cluster
        user: dev-admin
        namespace: zzz
    - name: staging-cluster
      context:
        cluster: staging-cluster
        user: staging-admin
        namespace: zz
    - name: prod-cluster
      context:
        cluster: prod-cluster
        user: prod-admin
        namespace: production
    - name: aws-eks-cluster
      context:
        cluster: aws-eks-cluster
        user: aws-eks-user
        namespace: default
    - name: gke-cluster
      context:
        cluster: gke-cluster
        user: gke-user
        namespace: default
