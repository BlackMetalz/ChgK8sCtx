apiVersion: v1
kind: Config
current-context: dev-cluster
clusters:
  - name: dev-cluster
    cluster:
      server: https://dev.k8s.example.com:6443
      certificate-authority-data: FAKE_CERT
  - name: staging-cluster
    cluster:
      server: https://staging.k8s.example.com:6443
      certificate-authority-data: FAKE_CERT
users:
  - name: dev-admin
    user:
      client-certificate-data: FAKE_CERT
      client-key-data: FAKE_KEY
  - name: staging-admin
    user:
      client-certificate-data: FAKE_CERT
      client-key-data: FAKE_KEY
contexts:
  - name: dev-cluster
    context:
      cluster: dev-cluster
      user: dev-admin
  - name: staging-cluster
    context:
      cluster: staging-cluster
      user: staging-admin