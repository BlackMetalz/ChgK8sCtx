# Contexts (linking clusters to users)
contexts:
  - name: dev-cluster
    context:
      cluster: dev-cluster
      user: dev-admin
      namespace: default

  - name: staging-cluster
    context:
      cluster: staging-cluster
      user: staging-admin
      namespace: staging

  - name: prod-cluster
    context:
      cluster: prod-cluster
      user: prod-admin
      namespace: production

  - name: aws-eks-cluster
    context:
      cluster: aws-eks-cluster
      user: aws-eks-user
      namespace: default

  - name: gke-cluster
    context:
      cluster: gke-cluster
      user: gke-user
      namespace: default
