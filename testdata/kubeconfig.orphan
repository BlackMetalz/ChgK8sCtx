apiVersion: v1
kind: Config
preferences: {}
current-context: dev-cluster
clusters:
    # USED by context "dev-cluster"
    - name: dev-cluster
      cluster:
        server: https://dev.k8s.example.com:6443
        certificate-authority-data: FAKE_CERT_DATA
    # ORPHAN - not used by any context
    - name: orphan-cluster-1
      cluster:
        server: https://orphan1.k8s.example.com:6443
        certificate-authority-data: FAKE_CERT_DATA
    # ORPHAN - not used by any context
    - name: orphan-cluster-2
      cluster:
        server: https://orphan2.k8s.example.com:6443
        certificate-authority-data: FAKE_CERT_DATA
    # USED by context "prod-cluster"
    - name: prod-cluster
      cluster:
        server: https://prod.k8s.example.com:6443
        certificate-authority-data: FAKE_CERT_DATA
users:
    # USED by context "dev-cluster"
    - name: dev-admin
      user:
        client-certificate-data: FAKE_CERT
        client-key-data: FAKE_KEY
    # ORPHAN - not used by any context
    - name: orphan-user-1
      user:
        client-certificate-data: FAKE_CERT
        client-key-data: FAKE_KEY
    # ORPHAN - not used by any context
    - name: orphan-user-2
      user:
        client-certificate-data: FAKE_CERT
        client-key-data: FAKE_KEY
    # ORPHAN - not used by any context  
    - name: old-admin
      user:
        client-certificate-data: FAKE_CERT
        client-key-data: FAKE_KEY
    # USED by context "prod-cluster"
    - name: prod-admin
      user:
        client-certificate-data: FAKE_CERT
        client-key-data: FAKE_KEY
contexts:
    - name: dev-cluster
      context:
        cluster: dev-cluster
        user: dev-admin
        namespace: development
    - name: prod-cluster
      context:
        cluster: prod-cluster
        user: prod-admin
        namespace: production
